# Database Configuration for Facility Management System (FMS)
# Conforms to NFR-04: DB credentials kept in config file, not hardcoded in source code

db.url=jdbc:mysql://localhost:3306/fms_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
db.user=root
db.password=CHANGE_ME
# HikariCP Connection Pool Settings (NFR-09: Scalability & Performance)
db.pool.maxSize=10
db.pool.minIdle=2
db.pool.connectionTimeout=15000
db.pool.idleTimeout=600000
db.pool.maxLifetime=1800000
