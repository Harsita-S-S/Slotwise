<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fms.controller.BookingController"
      spacing="18" style="-fx-padding: 24;">

    <!-- ============================================================
         HEADER SECTION & VIEW MODE TABS
         ============================================================ -->
    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Availability &amp; Room Booking" styleClass="card-title" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #4A3E3D;" />
            <Label text="Browse facilities, reserve single or multi-day time slots, and manage booking requests."
                   styleClass="card-subtitle" />
        </VBox>

        <!-- View Mode Navigation Tabs -->
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="btnTabAvailability" text="🏢 Browse &amp; Book"
                    styleClass="view-toggle-btn-active" onAction="#handleSwitchToAvailability" />
            <Button fx:id="btnTabMyBookings" text="📋 My Bookings"
                    styleClass="view-toggle-btn" onAction="#handleSwitchToMyBookings" />
            <Button fx:id="btnTabAdminApprovals" text="🛡️ Approvals Console"
                    styleClass="view-toggle-btn" onAction="#handleSwitchToAdminApprovals" />
        </HBox>
    </HBox>

    <!-- Status Banner / Feedback Alert -->
    <HBox fx:id="alertBanner" visible="false" managed="false" alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: rgba(217, 119, 87, 0.12); -fx-border-color: #D97757; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 16;">
        <Label fx:id="alertMessageLabel" text="Alert message" style="-fx-text-fill: #4A3E3D; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" />
        <Button text="✕" style="-fx-background-color: transparent; -fx-text-fill: #7A6B66; -fx-cursor: hand;" onAction="#handleDismissAlert" />
    </HBox>

    <!-- ============================================================
         VIEW 1: FACILITY DIRECTORY & BOOKING LAUNCHER
         ============================================================ -->
    <VBox fx:id="availabilityPane" spacing="16" VBox.vgrow="ALWAYS">

        <!-- Search & Filter Bar Card -->
        <VBox styleClass="card" spacing="12">
            <!-- Row 1: Search Field -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="🔍  Search by facility name, building, or amenities..."
                           HBox.hgrow="ALWAYS" styleClass="text-field" />
            </HBox>

            <!-- Row 2: Filters and Primary Action Button -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="typeFilterCombo" promptText="All Types" prefWidth="150" />
                <TextField fx:id="minCapacityField" promptText="Min Attendees" prefWidth="130" />
                <Button text="Reset Filters" styleClass="btn-secondary" onAction="#handleResetFilters" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnNewBooking" text="⚡ + New Booking" styleClass="btn-primary" onAction="#handleOpenNewBookingDialog" />
            </HBox>
        </VBox>

        <!-- Facility Table Directory -->
        <TableView fx:id="facilityTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colFacilityName" text="Facility Name" prefWidth="210" />
                <TableColumn fx:id="colFacilityType" text="Type" prefWidth="130" />
                <TableColumn fx:id="colFacilityLocation" text="Location" prefWidth="180" />
                <TableColumn fx:id="colFacilityCapacity" text="Capacity" prefWidth="100" />
                <TableColumn fx:id="colFacilityAmenities" text="Amenities" prefWidth="230" />
                <TableColumn fx:id="colFacilityPolicy" text="Approval Policy" prefWidth="130" />
                <TableColumn fx:id="colFacilityAction" text="Action" prefWidth="130" />
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="8" style="-fx-padding: 30;">
                    <Label text="No facilities found matching your filters." style="-fx-text-fill: #7A6B66; -fx-font-size: 14px;" />
                    <Label text="Try adjusting your search query or resetting filters." style="-fx-text-fill: #998C87; -fx-font-size: 12px;" />
                </VBox>
            </placeholder>
        </TableView>

    </VBox>

    <!-- ============================================================
         VIEW 2: MY BOOKINGS (FR-BKG-08, FR-BKG-11)
         ============================================================ -->
    <VBox fx:id="myBookingsPane" spacing="14" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="My Active &amp; Upcoming Bookings" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A3E3D;" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="↻ Refresh" styleClass="btn-secondary" onAction="#loadMyBookings" />
        </HBox>

        <TableView fx:id="myBookingsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colMyFacility" text="Facility" prefWidth="170" />
                <TableColumn fx:id="colMyBuilding" text="Location" prefWidth="140" />
                <TableColumn fx:id="colMyDate" text="Date" prefWidth="100" />
                <TableColumn fx:id="colMySlot" text="Time Slot" prefWidth="120" />
                <TableColumn fx:id="colMyAttendees" text="Attendees" prefWidth="85" />
                <TableColumn fx:id="colMyPurpose" text="Purpose" prefWidth="200" />
                <TableColumn fx:id="colMyStatus" text="Status" prefWidth="110" />
                <TableColumn fx:id="colMyActions" text="Action" prefWidth="110" />
            </columns>
            <placeholder>
                <Label text="You have no bookings yet. Reserve a space in the 'Browse &amp; Book' tab." style="-fx-text-fill: #7A6B66;" />
            </placeholder>
        </TableView>
    </VBox>

    <!-- ============================================================
         VIEW 3: ADMIN APPROVALS CONSOLE (FR-BKG-06, FR-BKG-07)
         ============================================================ -->
    <VBox fx:id="adminApprovalsPane" spacing="14" visible="false" managed="false" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="Pending &amp; Reviewed Reservations" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #4A3E3D;" />
            <Region HBox.hgrow="ALWAYS" />
            <Label text="Filter Date:" style="-fx-font-size: 12px; -fx-text-fill: #7A6B66;" />
            <DatePicker fx:id="adminDatePicker" prefWidth="150" />
            <ComboBox fx:id="adminStatusFilterCombo" prefWidth="130" />
            <Button text="↻ Refresh" styleClass="btn-secondary" onAction="#loadAdminBookings" />
        </HBox>

        <TableView fx:id="adminBookingsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colAdminId" text="ID" prefWidth="55" />
                <TableColumn fx:id="colAdminUser" text="Requested By" prefWidth="140" />
                <TableColumn fx:id="colAdminFacility" text="Facility" prefWidth="160" />
                <TableColumn fx:id="colAdminDate" text="Date" prefWidth="100" />
                <TableColumn fx:id="colAdminSlot" text="Time Slot" prefWidth="120" />
                <TableColumn fx:id="colAdminAttendees" text="Attendees" prefWidth="85" />
                <TableColumn fx:id="colAdminPurpose" text="Purpose" prefWidth="180" />
                <TableColumn fx:id="colAdminStatus" text="Status" prefWidth="100" />
                <TableColumn fx:id="colAdminActions" text="Actions" prefWidth="160" />
            </columns>
            <placeholder>
                <Label text="No booking requests found for the selected filter." style="-fx-text-fill: #7A6B66;" />
            </placeholder>
        </TableView>
    </VBox>

</VBox>
