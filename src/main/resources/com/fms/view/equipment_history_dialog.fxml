<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  SlotWise Equipment Maintenance History Dialog (FR-EQP-04)
-->
<VBox spacing="16" prefWidth="760" prefHeight="480" styleClass="card"
      style="-fx-padding: 24; -fx-background-color: #FFFFFF;"
      xmlns:fx="http://javafx.com/fxml">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🔧" style="-fx-font-size: 20px;" />
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label fx:id="historyTitleLabel" text="Equipment Maintenance History" styleClass="card-title" />
            <Label fx:id="historySubtitleLabel" text="Past and active service logs, repairs, and inspections"
                   styleClass="card-subtitle" />
        </VBox>
    </HBox>

    <Region prefHeight="1" style="-fx-background-color: #E5DDD0;" />

    <!-- History Table -->
    <TableView fx:id="historyTable" VBox.vgrow="ALWAYS" styleClass="table-view">
        <columns>
            <TableColumn fx:id="colReqId" text="ID" prefWidth="60" />
            <TableColumn fx:id="colReqDate" text="Date Raised" prefWidth="120" />
            <TableColumn fx:id="colReqDesc" text="Issue Description" prefWidth="240" />
            <TableColumn fx:id="colReqPriority" text="Priority" prefWidth="90" />
            <TableColumn fx:id="colReqStatus" text="Status" prefWidth="110" />
            <TableColumn fx:id="colReqStaff" text="Assigned Staff" prefWidth="120" />
        </columns>
    </TableView>

    <!-- Footer / Close -->
    <HBox alignment="CENTER_RIGHT">
        <Button fx:id="closeButton" text="Close" styleClass="btn-secondary" />
    </HBox>

</VBox>
