<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  SlotWise Move Equipment Dialog (FR-EQP-03)
-->
<VBox spacing="16" prefWidth="460" styleClass="card"
      style="-fx-padding: 24; -fx-background-color: #FFFFFF;"
      xmlns:fx="http://javafx.com/fxml">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🔄" style="-fx-font-size: 20px;" />
        <VBox spacing="2">
            <Label text="Relocate Equipment Asset" styleClass="card-title" />
            <Label text="Transfer equipment to a different institutional facility space" styleClass="card-subtitle" />
        </VBox>
    </HBox>

    <Region prefHeight="1" style="-fx-background-color: #E5DDD0;" />

    <!-- Current Equipment Summary Card -->
    <VBox spacing="6" style="-fx-background-color: #F7F4EF; -fx-padding: 12; -fx-background-radius: 6; -fx-border-color: #E5DDD0; -fx-border-radius: 6;">
        <Label fx:id="equipmentSummaryLabel" text="Equipment: Dell Precision 3660 [DELL-WS-0982]"
               style="-fx-font-weight: bold; -fx-text-fill: #4A3E3D;" />
        <Label fx:id="currentFacilityLabel" text="Current Location: Advanced Computing Lab"
               style="-fx-font-size: 12px; -fx-text-fill: #7A6B66;" />
    </VBox>

    <!-- Destination Facility Selection -->
    <VBox spacing="6">
        <Label text="Destination Facility *" styleClass="field-label" />
        <ComboBox fx:id="destinationFacilityCombo" promptText="Select Destination Facility"
                  maxWidth="Infinity" styleClass="combo-box" />
    </VBox>

    <!-- Error label -->
    <Label fx:id="moveErrorLabel" text="" styleClass="error-label" wrapText="true" visible="false" managed="false" />

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="cancelButton" text="Cancel" styleClass="btn-secondary" />
        <Button fx:id="confirmMoveButton" text="Confirm Relocation" styleClass="btn-primary" />
    </HBox>

</VBox>
