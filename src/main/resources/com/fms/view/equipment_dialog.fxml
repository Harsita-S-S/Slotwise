<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!--
  SlotWise Add/Edit Equipment Dialog (FR-EQP-01, FR-EQP-02)
-->
<VBox spacing="16" prefWidth="500" styleClass="card"
      style="-fx-padding: 24; -fx-background-color: #FFFFFF;"
      xmlns:fx="http://javafx.com/fxml">

    <!-- Dialog Header -->
    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="📦" style="-fx-font-size: 20px;" />
        <VBox spacing="2">
            <Label fx:id="dialogTitle" text="Add Equipment" styleClass="card-title" />
            <Label text="Register or modify institutional equipment asset records" styleClass="card-subtitle" />
        </VBox>
    </HBox>

    <Region prefHeight="1" style="-fx-background-color: #E5DDD0;" />

    <!-- Form Fields Grid -->
    <GridPane hgap="12" vgap="12">

        <!-- Linked Facility -->
        <Label text="Linked Facility *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <ComboBox fx:id="facilityComboBox" promptText="Select Facility Space" maxWidth="Infinity" styleClass="combo-box"
                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

        <!-- Equipment Name -->
        <Label text="Equipment Name *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <TextField fx:id="nameField" promptText="e.g. Dell Precision 3660 Workstation" styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

        <!-- Category -->
        <Label text="Category *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="categoryField" promptText="e.g. Workstation, Projector, Audio" styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="2" />

        <!-- Serial Number -->
        <Label text="Serial Number *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="3" />
        <TextField fx:id="serialField" promptText="e.g. DELL-WS-0982" styleClass="text-field"
                   GridPane.columnIndex="1" GridPane.rowIndex="3" />

        <!-- Purchase Date -->
        <Label text="Purchase Date *" styleClass="field-label" GridPane.columnIndex="0" GridPane.rowIndex="4" />
        <DatePicker fx:id="purchaseDatePicker" promptText="Select Date" maxWidth="Infinity" styleClass="combo-box"
                    GridPane.columnIndex="1" GridPane.rowIndex="4" />

        <!-- Condition Status (visible when editing) -->
        <Label fx:id="conditionLabel" text="Condition Status" styleClass="field-label"
               GridPane.columnIndex="0" GridPane.rowIndex="5" />
        <ComboBox fx:id="conditionComboBox" maxWidth="Infinity" styleClass="combo-box"
                  GridPane.columnIndex="1" GridPane.rowIndex="5" />

    </GridPane>

    <!-- Error message display -->
    <Label fx:id="dialogErrorLabel" text="" styleClass="error-label" wrapText="true" visible="false" managed="false" />

    <!-- Action Buttons -->
    <HBox alignment="CENTER_RIGHT" spacing="12">
        <Button fx:id="cancelButton" text="Cancel" styleClass="btn-secondary" />
        <Button fx:id="saveButton" text="Save Equipment" styleClass="btn-primary" />
    </HBox>

</VBox>
